# Example environment file. Copy to .env and fill in.
# NEVER commit your real .env — it is covered by .gitignore.

# --- App ---
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite default. For Postgres use:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/spendsense
DATABASE_URL=sqlite:///./spendsense.db

# --- LLM (optional) ---
# Without a key the app falls back to a deterministic rule-based categorizer
# so the whole system still runs. Costs are always logged either way.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Behaviour ---
# Caching
CACHE_TTL_SECONDS=60
# Scheduler
ENABLE_SCHEDULER=true
AUTO_CATEGORIZE_INTERVAL_MINUTES=5
REPORT_CRON_HOUR=8
REPORT_CRON_MINUTE=0